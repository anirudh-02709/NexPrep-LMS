# Server Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/nexprep
JWT_SECRET=replace_with_a_secure_jwt_secret

# CORS Whitelist (comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://your-frontend-app.netlify.app

# Firebase Admin Credentials (Optional for Google OAuth)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
